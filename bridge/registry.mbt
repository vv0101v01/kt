///|
pub fn bridge_retirement_reason(id : String) -> String {
  match id {
    "K6-11" =>
      "No constructed Adams/Brunerie comparison map; independent invariant checks are not a bridge."
    "K6-13" =>
      "Tropical roots and liquid subadditivity are independent; no shared object or transport."
    "K7-18" =>
      "Viro ties and tensor implication order are independent; no structure transport."
    "K7-21" =>
      "Ledger hashing and Clifford centers are independent; sealing is not a mathematical bridge."
    "K9-35" =>
      "No soundness map from discovered tensor implications to the unrelated Horn and focused proofs."
    "K9-36" =>
      "Only meta/reflect is executed; there is no Accel data path, independent hardware comparison or acceleration."
    _ => ""
  }
}
