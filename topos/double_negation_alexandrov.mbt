///|
// Double-Negation Presheaf Template j(x) = ¬¬x, Boolean Sheaf Subtopos Sh_¬¬(E),
// Alexandrov–Grothendieck Specialization Galois Duality, Bi-Heyting Co-Negation,
// and Universal Chu Space Self-Duality.
//
// Core Axioms & Theorems realized in this module:
//   * [Ax-Universal-Spectrum] Every modal / transition endomorphism `T` induced
//     on a finite sieve or state module admits an exact F_p singular resonance
//     spectrum `σ(T) = { λ ∈ F_p | det(λI − T) = 0 }` computed via `@gcd`.
//   * [T-DoubleNeg-Nucleus] `j(p) = ¬¬p` satisfies `j(⊤) = ⊤`, `j(j(p)) = j(p)`,
//     `j(p ∧ q) = j(p) ∧ j(q)`, `¬¬¬p = ¬p`, and corresponds under the
//     Lawvere–Tierney Galois bijection to `topology_dense(cat)`.
//   * [T-Barr-Glivenko-Booleanization] `Sh_¬¬(PSh(C))` is always a Boolean topos
//     (`¬¬(p ∨ ¬p) = ⊤`), while `PSh(C)` on the Sierpiński arrow `0 -> 1` refutes
//     raw excluded middle; `a_¬¬ ⊣ i_¬¬` is a left-exact left adjoint.
//   * [T-BiHeyting-Sieve-Duality] Presheaf sieves carry a complete bi-Heyting
//     structure with co-Heyting subtraction `(S ⇐ T) = ⟨S \ T⟩_sieve`,
//     supplement `~S = M_u ⇐ S`, boundary `∂S = S ∩ ~S`, satisfying both
//     adjunctions `(A ∩ B ⊆ C ⇔ A ⊆ B ⇒ C)` and `(A ⇐ B ⊆ C ⇔ A ⊆ B ∪ C)`
//     plus the supplement sandwich `~~S ⊆ S ⊆ ¬¬S`.
//   * [T-Alexandrov-Galois-Duality] Downward-closed Alexandrov opens `O_Alex(P)`
//     and specialization preorder `x ≤_spec y` form an exact Galois isomorphism
//     on finite posets, with `PSh(P) ≃ Sh(X_P, O_Alex(P))`.
//   * [T-Chu-Universal-Duality] `Chu(Set, K)` transpose `(A, X, r)^⊥ = (X, A, r^T)`
//     is an exact contravariant involution unifying finite sets, Alexandrov
//     spaces, F_p-linear spaces, and transition systems, with bi-extensional
//     quotient elimination.

///|
/// Heyting negation `¬S = (S ⇒ ∅_target)` of a sieve `s` in `PSh(c)`.
pub fn sieve_heyting_neg(c : @sym.FinCat, s : Sieve) -> Sieve {
  sieve_heyting_implies(c, s, sieve_empty(s.target))
}

///|
/// Double-negation nucleus `j_¬¬(S) = ¬¬S` on sieves in `PSh(c)`.
pub fn sieve_double_negation(c : @sym.FinCat, s : Sieve) -> Sieve {
  sieve_heyting_neg(c, sieve_heyting_neg(c, s))
}

///|
/// Co-Heyting subtraction `(S ⇐ T)`: the smallest sieve `R` on `s.target`
/// such that `S ⊆ T ∪ R`, computed in `O(|S| · |Mor(C)|)` as the sieve
/// generated by the set-theoretic difference `S \ T`.
pub fn sieve_coheyting_sub(c : @sym.FinCat, s : Sieve, t : Sieve) -> Sieve {
  guard s.target == t.target else {
    abort("sieve_coheyting_sub: sieve target mismatch")
  }
  let diff : Array[Int32] = []
  for f in s.arrows {
    if !sieve_contains(t, f) {
      diff.push(f)
    }
  }
  sieve_generate(c, s.target, diff)
}

///|
/// Co-Heyting negation (supplement) `~S = (M_target ⇐ S)`: smallest sieve
/// whose union with `S` covers the maximal sieve `M_target`.
pub fn sieve_coheyting_neg(c : @sym.FinCat, s : Sieve) -> Sieve {
  sieve_coheyting_sub(c, sieve_maximal(c, s.target), s)
}

///|
/// Co-Heyting topological boundary `∂S = S ∩ ~S` in `PSh(c)`.
pub fn sieve_coheyting_boundary(c : @sym.FinCat, s : Sieve) -> Sieve {
  sieve_inter(s, sieve_coheyting_neg(c, s))
}

///|
/// Construct the Lawvere–Tierney double-negation modality `j_¬¬ : Ω => Ω`
/// on the presheaf topos `PSh(c)`, together with its ambient `Ω` classifier.
pub fn double_negation_lt_operator(
  c : @sym.FinCat,
) -> (SubobjectClassifierData, PresheafHom) {
  let omega_psh = subobject_classifier_presheaf(c)
  let comps : Array[Array[Int32]] = []
  for u in 0..<c.nobj {
    let sieves_u = omega_psh.closed_sieves[u]
    let cu = Array::make(sieves_u.length(), 0)
    for i in 0..<sieves_u.length() {
      let nn_s = sieve_double_negation(c, sieves_u[i])
      let mut idx = -1
      for k in 0..<sieves_u.length() {
        if sieves_u[k] == nn_s {
          idx = k
          break
        }
      }
      guard idx >= 0 else {
        abort("double_negation_lt_operator: ¬¬S not found in Ω(u)")
      }
      cu[i] = idx
    }
    comps.push(cu)
  }
  let j_hom : PresheafHom = {
    cat: c,
    dom_size: omega_psh.omega.size.copy(),
    cod_size: omega_psh.omega.size.copy(),
    components: comps,
  }
  (omega_psh, j_hom)
}

///|
/// Build the double-negation Grothendieck site `(c, J_¬¬)` whose category of
/// sheaves `Sh_¬¬(PSh(c))` is the Booleanization of `PSh(c)`.
pub fn double_negation_sheaf_site(c : @sym.FinCat) -> Site {
  let (omega_psh, j_nn) = double_negation_lt_operator(c)
  site_new(c, topology_of_lawvere_tierney(omega_psh, j_nn))
}

///|
/// Compute the F_p singular resonance spectrum `σ(T) = { λ ∈ F_p | det(λI − T) = 0 }`
/// of a finite endomorphism `op : {0..n-1} -> {0..n-1}` lifted to `F_p^n`,
/// plus `(fixed_dim = dim ker(I − T), zero_kernel_dim = dim ker(T))`.
pub fn operator_singular_spectrum_fp(
  n : Int32,
  op : (Int32) -> Int32,
  p : Int32,
) -> (Array[Int32], Int32, Int32) {
  let rows : Array[Array[Int32]] = []
  for _ in 0..<n {
    rows.push(Array::make(n, 0))
  }
  for j in 0..<n {
    let img = op(j)
    if img >= 0 && img < n {
      rows[img][j] = @gcd.fp_add(rows[img][j], 1, p)
    }
  }
  let t_mat = @gcd.fp_mat_from_rows(rows, p)
  let zero_ker_dim = n - @gcd.fp_rank(t_mat)
  let spectrum : Array[Int32] = []
  let mut fixed_dim = 0
  for lam in 0..<p {
    let shifted : Array[Array[Int32]] = []
    for i in 0..<n {
      let r = Array::make(n, 0)
      for j in 0..<n {
        let diag = if i == j { lam } else { 0 }
        r[j] = @gcd.fp_sub(diag, rows[i][j], p)
      }
      shifted.push(r)
    }
    let m_lam = @gcd.fp_mat_from_rows(shifted, p)
    let rk = @gcd.fp_rank(m_lam)
    if rk < n {
      spectrum.push(lam)
    }
    if lam == 1 {
      fixed_dim = n - rk
    }
  }
  (spectrum, fixed_dim, zero_ker_dim)
}

///|
/// Quantitative verification report for the Double-Negation Presheaf Template
/// `(j(x) = ¬¬x, Sh_j(E), a_j ⊣ i_j)` and Bi-Heyting sieve duality.
#derive(Debug, Eq)
pub(all) struct DoubleNegationTemplateReport {
  lt_nucleus_valid : Bool
  idempotent_all_sieves : Bool
  inflationary_all_sieves : Bool
  triple_negation_holds : Bool
  matches_dense_topology : Bool
  ambient_sierpinski_non_boolean : Bool
  sheaf_subtopos_boolean : Bool
  glivenko_holds_all_sieves : Bool
  left_adjoint_bijection_holds : Bool
  left_exact_terminal_and_product : Bool
  biheyting_adjunctions_hold : Bool
  supplement_sandwich_holds : Bool
  spectral_projector_eigenvalues : Array[Int32]
  omega_total_sieves : Int32
  omega_nn_stable_sieves : Int32
  eliminated_intermediate_sieves : Int32
}

///|
pub extend DoubleNegationTemplateReport with @moonbitlang/core/debug.Debug::{
  to_repr,
}

///|
pub extend DoubleNegationTemplateReport with Eq::{not_equal, equal}

///|
/// Verify the Double-Negation Presheaf Template `j(x) = ¬¬x`, `Sh_¬¬(E)`,
/// left-exact left adjoint `a_¬¬ ⊣ i_¬¬`, Bi-Heyting co-negation, and
/// F_5 projector spectrum on the canonical Sierpiński category `0 -> 1`
/// and poset span `1 <- 0 -> 2`.
pub fn verify_double_negation_presheaf_template() -> DoubleNegationTemplateReport {
  let c = @sym.cat_arrow() // 0 -> 1 (Sierpiński presheaf base)
  let (omega_psh, j_nn) = double_negation_lt_operator(c)
  let lt_ok = is_lawvere_tierney_operator(omega_psh, j_nn)
  let j_top = topology_of_lawvere_tierney(omega_psh, j_nn)
  let dense_top = topology_dense(c)
  let dense_match = j_top == dense_top
  let triv_site = site_new(c, topology_trivial(c))
  let nn_site = site_new(c, j_top)
  let amb_non_bool = !is_boolean_topos(triv_site)
  let sub_bool = is_boolean_topos(nn_site)

  let mut idem_ok = true
  let mut infl_ok = true
  let mut triple_ok = true
  let mut gliv_ok = true
  let mut biheyt_ok = true
  let mut sandwich_ok = true
  let mut total_sieves = 0
  let mut stable_sieves = 0

  let test_cats = [c, @sym.cat_span()]
  for tc in test_cats {
    for u in 0..<tc.nobj {
      let sieves = all_sieves_on(tc, u)
      let max_u = sieve_maximal(tc, u)
      if tc.nobj == c.nobj && tc.nmor == c.nmor {
        total_sieves = total_sieves + sieves.length()
      }
      for s in sieves {
        let ns = sieve_heyting_neg(tc, s)
        let nns = sieve_double_negation(tc, s)
        let nnns = sieve_heyting_neg(tc, nns)
        let j_nns = sieve_double_negation(tc, nns)
        if !sieve_subset(s, nns) {
          infl_ok = false
        }
        if j_nns != nns {
          idem_ok = false
        }
        if nnns != ns {
          triple_ok = false
        }
        if tc.nobj == c.nobj && tc.nmor == c.nmor && nns == s {
          stable_sieves = stable_sieves + 1
        }
        let lem_s = sieve_union(s, ns)
        if sieve_double_negation(tc, lem_s) != max_u {
          gliv_ok = false
        }
        let co_s = sieve_coheyting_neg(tc, s)
        let coco_s = sieve_coheyting_neg(tc, co_s)
        let cococo_s = sieve_coheyting_neg(tc, coco_s)
        if !sieve_subset(coco_s, s) ||
          !sieve_subset(s, nns) ||
          cococo_s != co_s ||
          sieve_union(s, co_s) != max_u {
          sandwich_ok = false
        }
        let bnd_s = sieve_coheyting_boundary(tc, s)
        if !sieve_is_valid(tc, bnd_s) || !sieve_subset(bnd_s, s) {
          sandwich_ok = false
        }
        for t in sieves {
          let imp_t_r = sieve_heyting_implies(tc, s, t)
          let sub_s_t = sieve_coheyting_sub(tc, s, t)
          if !sieve_is_valid(tc, sub_s_t) {
            biheyt_ok = false
          }
          for r in sieves {
            let lhs_h = sieve_subset(sieve_inter(r, s), t)
            let rhs_h = sieve_subset(r, imp_t_r)
            if lhs_h != rhs_h {
              biheyt_ok = false
            }
            let lhs_c = sieve_subset(sub_s_t, r)
            let rhs_c = sieve_subset(s, sieve_union(t, r))
            if lhs_c != rhs_c {
              biheyt_ok = false
            }
          }
        }
      }
    }
  }

  // Verify left-exactness & left-adjointness of a_¬¬ : PSh(c) -> Sh_¬¬(PSh(c))
  let p0 = presheaf_representable(c, 0)
  let p1 = presheaf_representable(c, 1)
  let sh_p0 = sheafify(nn_site, p0).sheaf
  let sh_p1 = sheafify(nn_site, p1).sheaf
  let adj_ok = is_sheaf(nn_site, sh_p0) &&
    is_sheaf(nn_site, sh_p1) &&
    verify_sheafification_universal_property(nn_site, p1, sh_p0) &&
    verify_sheafification_universal_property(
      nn_site,
      omega_psh.omega,
      presheaf_constant_raw(c, 2),
    )

  let term = presheaf_terminal(c)
  let sh_term = sheafify(nn_site, term).sheaf
  let (prod_p, _, _) = presheaf_product(p1, omega_psh.omega)
  let sh_prod = sheafify(nn_site, prod_p).sheaf
  let sh_om = sheafify(nn_site, omega_psh.omega).sheaf
  let (prod_sh, _, _) = presheaf_product(sh_p1, sh_om)
  let lex_ok = presheaf_are_isomorphic(sh_term, term) &&
    presheaf_are_isomorphic(sh_prod, prod_sh)

  // Spectral projector check on Ω(1) of Sierpiński `0 -> 1` (3 sieves: ∅, {0->1}, M_1)
  let n_om1 = omega_psh.omega.size[1]
  let (eigs, fix_dim, ker_dim) = operator_singular_spectrum_fp(
    n_om1,
    fn(idx) { j_nn.components[1][idx] },
    5,
  )
  let spec_ok = eigs == [0, 1] &&
    fix_dim == 2 &&
    ker_dim == 1 &&
    fix_dim + ker_dim == n_om1

  {
    lt_nucleus_valid: lt_ok && spec_ok,
    idempotent_all_sieves: idem_ok,
    inflationary_all_sieves: infl_ok,
    triple_negation_holds: triple_ok,
    matches_dense_topology: dense_match,
    ambient_sierpinski_non_boolean: amb_non_bool,
    sheaf_subtopos_boolean: sub_bool,
    glivenko_holds_all_sieves: gliv_ok,
    left_adjoint_bijection_holds: adj_ok,
    left_exact_terminal_and_product: lex_ok,
    biheyting_adjunctions_hold: biheyt_ok,
    supplement_sandwich_holds: sandwich_ok,
    spectral_projector_eigenvalues: eigs,
    omega_total_sieves: total_sieves,
    omega_nn_stable_sieves: stable_sieves,
    eliminated_intermediate_sieves: total_sieves - stable_sieves,
  }
}

///|
/// Finite Alexandrov topological space induced by a preorder `(n, leq)` where
/// `U` is open iff `y ∈ U ∧ x ≤ y ⇒ x ∈ U` (downward-closed sieve opens).
#derive(Debug, Eq)
pub(all) struct AlexandrovSpace {
  n : Int32
  leq : Array[Array[Bool]]
  opens : Array[Array[Bool]]
}

///|
pub extend AlexandrovSpace with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend AlexandrovSpace with Eq::{not_equal, equal}

///|
/// Check whether subset `u` (length `n`) is downward-closed in `(n, leq)`.
pub fn is_alexandrov_open(
  n : Int32,
  leq : Array[Array[Bool]],
  u : Array[Bool],
) -> Bool {
  if u.length() != n {
    return false
  }
  for y in 0..<n {
    if u[y] {
      for x in 0..<n {
        if leq[x][y] && !u[x] {
          return false
        }
      }
    }
  }
  true
}

///|
/// Build the complete Alexandrov open-set frame `O_Alex(P)` from a reflexive
/// transitive preorder `leq` on `0..n-1` (`n ≤ 10`).
pub fn alexandrov_from_preorder(
  n : Int32,
  leq : Array[Array[Bool]],
) -> AlexandrovSpace {
  let total = 1 << n
  let opens : Array[Array[Bool]] = []
  for mask in 0..<total {
    let u = Array::make(n, false)
    for i in 0..<n {
      if ((mask >> i) & 1) == 1 {
        u[i] = true
      }
    }
    if is_alexandrov_open(n, leq, u) {
      opens.push(u)
    }
  }
  { n, leq, opens, }
}

///|
/// Recover the specialization preorder `x ≤_spec y ⇔ ∀U ∈ O(X), (y ∈ U ⇒ x ∈ U)`
/// from an Alexandrov open-set family.
pub fn alexandrov_specialization_preorder(
  space : AlexandrovSpace,
) -> Array[Array[Bool]] {
  let spec : Array[Array[Bool]] = []
  for x in 0..<space.n {
    let row = Array::make(space.n, true)
    for y in 0..<space.n {
      let mut ok = true
      for u in space.opens {
        if u[y] && !u[x] {
          ok = false
          break
        }
      }
      row[y] = ok
    }
    spec.push(row)
  }
  spec
}

///|
/// Verify Alexandrov–Grothendieck Galois Specialization Duality `(P, ≤) ≅ Spec(O_Alex(P))`
/// and comparison with `PSh(P)` on the diamond poset `0 ≤ {1, 2} ≤ 3`.
pub fn verify_alexandrov_grothendieck_duality() -> Bool {
  let n = 4
  let edges = [(0, 1), (0, 2), (1, 3), (2, 3), (0, 3)]
  let leq : Array[Array[Bool]] = []
  for i in 0..<n {
    let r = Array::make(n, false)
    r[i] = true
    leq.push(r)
  }
  for (a, b) in edges {
    leq[a][b] = true
  }
  let space = alexandrov_from_preorder(n, leq)
  // Diamond poset has exactly 6 downward-closed sets:
  // ∅, {0}, {0,1}, {0,2}, {0,1,2}, {0,1,2,3}
  if space.opens.length() != 6 {
    return false
  }
  // Negative control: upward singleton `{3}` violates downward closure
  if is_alexandrov_open(n, leq, [false, false, false, true]) {
    return false
  }
  // Galois roundtrip: specialization preorder matches `leq` entry-by-entry
  let spec = alexandrov_specialization_preorder(space)
  if spec != leq {
    return false
  }
  // Frame laws: closed under arbitrary (here pairwise + empty/full) union & intersection
  for u in space.opens {
    for v in space.opens {
      let cup = Array::make(n, false)
      let cap = Array::make(n, false)
      for i in 0..<n {
        cup[i] = u[i] || v[i]
        cap[i] = u[i] && v[i]
      }
      if !is_alexandrov_open(n, leq, cup) || !is_alexandrov_open(n, leq, cap) {
        return false
      }
    }
  }
  // Poset category `C_P` has `|Ω_triv(3)| == 6` sieves on top element `3`,
  // matching `|O_Alex(P)| == 6` canonically!
  let poset_cat = @sym.cat_poset(n, [(0, 1), (0, 2), (1, 3), (2, 3)])
  let sieves_top = all_sieves_on(poset_cat, 3)
  let id_func : @sym.FinFunctor = {
    src: poset_cat,
    dst: poset_cat,
    obj: [0, 1, 2, 3],
    mor: [
      for m in 0..<poset_cat.nmor => m
    ],
  }
  let triv_site = site_new(poset_cat, topology_trivial(poset_cat))
  let rep_top = presheaf_representable(poset_cat, 3)
  sieves_top.length() == space.opens.length() &&
  verify_grothendieck_comparison_lemma(id_func, triv_site, rep_top)
}

///|
/// Finite Chu space `(A, X, K, r : A × X -> {0..K-1})` unifying sets,
/// Alexandrov spaces, linear dual pairings, and state transition systems.
#derive(Debug, Eq)
pub(all) struct ChuSpace {
  n_obj : Int32
  n_state : Int32
  k_alphabet : Int32
  matrix : Array[Array[Int32]]
}

///|
pub extend ChuSpace with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend ChuSpace with Eq::{not_equal, equal}

///|
/// Morphism `(forward : A1 -> A2, backward : X2 -> X1)` in `Chu(Set, K)`.
#derive(Debug, Eq)
pub(all) struct ChuMorphism {
  forward : Array[Int32]
  backward : Array[Int32]
}

///|
pub extend ChuMorphism with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend ChuMorphism with Eq::{not_equal, equal}

///|
/// Check the Chu adjointness matrix identity `r2(f(a), y) == r1(a, g(y))`
/// for all `a ∈ A1`, `y ∈ X2`.
pub fn chu_morphism_is_valid(
  c1 : ChuSpace,
  c2 : ChuSpace,
  m : ChuMorphism,
) -> Bool {
  if c1.k_alphabet != c2.k_alphabet ||
    m.forward.length() != c1.n_obj ||
    m.backward.length() != c2.n_state {
    return false
  }
  for a in 0..<c1.n_obj {
    let fa = m.forward[a]
    if fa < 0 || fa >= c2.n_obj {
      return false
    }
    for y in 0..<c2.n_state {
      let gy = m.backward[y]
      if gy < 0 || gy >= c1.n_state {
        return false
      }
      if c2.matrix[fa][y] != c1.matrix[a][gy] {
        return false
      }
    }
  }
  true
}

///|
/// Contravariant Chu transpose involution `(A, X, r)^⊥ = (X, A, r^T)`.
pub fn chu_transpose(c : ChuSpace) -> ChuSpace {
  let mat : Array[Array[Int32]] = []
  for x in 0..<c.n_state {
    let row = Array::make(c.n_obj, 0)
    for a in 0..<c.n_obj {
      row[a] = c.matrix[a][x]
    }
    mat.push(row)
  }
  { n_obj: c.n_state, n_state: c.n_obj, k_alphabet: c.k_alphabet, matrix: mat, }
}

///|
/// Transpose a Chu morphism `(f, g) : C1 -> C2` into `(g, f) : C2^⊥ -> C1^⊥`.
pub fn chu_morphism_transpose(m : ChuMorphism) -> ChuMorphism {
  { forward: m.backward.copy(), backward: m.forward.copy(), }
}

///|
/// Bi-extensional quotient elimination of a Chu space: identifies objects with
/// identical rows (`separated`) and states with identical columns (`extensional`).
pub fn chu_biextensional_collapse(c : ChuSpace) -> ChuSpace {
  let uniq_rows : Array[Array[Int32]] = []
  for a in 0..<c.n_obj {
    let mut seen = false
    for r in uniq_rows {
      if r == c.matrix[a] {
        seen = true
        break
      }
    }
    if !seen {
      uniq_rows.push(c.matrix[a].copy())
    }
  }
  let m_rows = uniq_rows.length()
  let uniq_col_indices : Array[Int32] = []
  for x in 0..<c.n_state {
    let mut dup = false
    for prev in uniq_col_indices {
      let mut same = true
      for i in 0..<m_rows {
        if uniq_rows[i][x] != uniq_rows[i][prev] {
          same = false
          break
        }
      }
      if same {
        dup = true
        break
      }
    }
    if !dup {
      uniq_col_indices.push(x)
    }
  }
  let out : Array[Array[Int32]] = []
  for i in 0..<m_rows {
    let row = Array::make(uniq_col_indices.length(), 0)
    for j in 0..<uniq_col_indices.length() {
      row[j] = uniq_rows[i][uniq_col_indices[j]]
    }
    out.push(row)
  }
  {
    n_obj: m_rows,
    n_state: uniq_col_indices.length(),
    k_alphabet: c.k_alphabet,
    matrix: out,
  }
}

///|
/// Embed a finite set `{0..n-1}` into `Chu(Set, 2)` via its Kronecker matrix.
pub fn chu_from_finset(n : Int32) -> ChuSpace {
  let mat : Array[Array[Int32]] = []
  for i in 0..<n {
    let r = Array::make(n, 0)
    r[i] = 1
    mat.push(r)
  }
  { n_obj: n, n_state: n, k_alphabet: 2, matrix: mat, }
}

///|
/// Embed an `AlexandrovSpace` into `Chu(Set, 2)` via membership `x ∈ U`.
pub fn chu_from_alexandrov(space : AlexandrovSpace) -> ChuSpace {
  let mat : Array[Array[Int32]] = []
  for x in 0..<space.n {
    let r = Array::make(space.opens.length(), 0)
    for j in 0..<space.opens.length() {
      r[j] = if space.opens[j][x] { 1 } else { 0 }
    }
    mat.push(r)
  }
  { n_obj: space.n, n_state: space.opens.length(), k_alphabet: 2, matrix: mat, }
}

///|
/// Embed an `F_3` vector space of dimension `2` (`9` vectors × `9` covectors)
/// into `Chu(Set, 3)` via bilinear evaluation `⟨v, φ⟩ mod 3`.
pub fn chu_from_f3_plane() -> ChuSpace {
  let mat : Array[Array[Int32]] = []
  for v in 0..<9 {
    let v0 = v % 3
    let v1 = v / 3
    let r = Array::make(9, 0)
    for w in 0..<9 {
      let w0 = w % 3
      let w1 = w / 3
      r[w] = (v0 * w0 + v1 * w1) % 3
    }
    mat.push(r)
  }
  { n_obj: 9, n_state: 9, k_alphabet: 3, matrix: mat, }
}

///|
/// Embed a labeled transition system `(n_states, transitions)` into `Chu(Set, 2)`.
pub fn chu_from_transition_system(
  n_states : Int32,
  edges : Array[(Int32, Int32)],
) -> ChuSpace {
  let mat : Array[Array[Int32]] = []
  for _ in 0..<n_states {
    mat.push(Array::make(n_states, 0))
  }
  for (u, v) in edges {
    if u >= 0 && u < n_states && v >= 0 && v < n_states {
      mat[u][v] = 1
    }
  }
  { n_obj: n_states, n_state: n_states, k_alphabet: 2, matrix: mat, }
}

///|
/// Verify Chu space self-duality `(C^⊥)^⊥ = C`, adjointness preservation under
/// transpose, bi-extensional collapse idempotence, and unified embeddings of
/// sets, Alexandrov spaces, `F_3^2` vector space, and transition systems.
pub fn verify_chu_space_universal_duality() -> Bool {
  let c_set = chu_from_finset(4)
  let leq = [[true, true, true], [false, true, true], [false, false, true]]
  let c_alex = chu_from_alexandrov(alexandrov_from_preorder(3, leq))
  let c_vec = chu_from_f3_plane()
  let c_lts = chu_from_transition_system(4, [(0, 1), (1, 2), (2, 0), (3, 0)])

  // 1. Exact involution (C^⊥)^⊥ == C across all 4 mathematical domains
  if chu_transpose(chu_transpose(c_set)) != c_set ||
    chu_transpose(chu_transpose(c_alex)) != c_alex ||
    chu_transpose(chu_transpose(c_vec)) != c_vec ||
    chu_transpose(chu_transpose(c_lts)) != c_lts {
    return false
  }

  // 2. Monotone map f : {0<=1<=2} -> {0<=1<=2}, f(x) = min(x+1, 2) induces
  //    inverse-image open pullback g = f^{-1} as a valid Chu morphism!
  let space3 = alexandrov_from_preorder(3, leq)
  let f_map = [1, 2, 2]
  let g_map = Array::make(space3.opens.length(), 0)
  for j in 0..<space3.opens.length() {
    let pulled = [
      space3.opens[j][f_map[0]],
      space3.opens[j][f_map[1]],
      space3.opens[j][f_map[2]],
    ]
    for k in 0..<space3.opens.length() {
      if space3.opens[k] == pulled {
        g_map[j] = k
        break
      }
    }
  }
  let morph : ChuMorphism = { forward: f_map, backward: g_map, }
  let morph_t = chu_morphism_transpose(morph)
  if !chu_morphism_is_valid(c_alex, c_alex, morph) ||
    !chu_morphism_is_valid(
      chu_transpose(c_alex),
      chu_transpose(c_alex),
      morph_t,
    ) {
    return false
  }
  // Negative control: scrambling backward map breaks Chu adjointness
  let bad_morph : ChuMorphism = { forward: f_map, backward: [0, 1, 2, 3], }
  if chu_morphism_is_valid(c_alex, c_alex, bad_morph) {
    return false
  }

  // 3. Bi-extensional quotient elimination reduces duplicate rows/cols & is idempotent
  let redundant : ChuSpace = {
    n_obj: 3,
    n_state: 3,
    k_alphabet: 2,
    matrix: [[1, 0, 1], [1, 0, 1], [0, 1, 0]],
  }
  let collapsed = chu_biextensional_collapse(redundant)
  let collapsed_twice = chu_biextensional_collapse(collapsed)
  // F_3^2 evaluation pairing is already non-degenerate (bi-extensional 9×9),
  // plus Sieve64 SWAR bi-Heyting SIP equivalence & F_2 vs F_3 torsion jump on RP^2!
  let rp2 = rp2_minimal_nerve()
  let rp2_f2 = nerve_cohomology_dimensions_fp(rp2, 2)
  let rp2_f3 = nerve_cohomology_dimensions_fp(rp2, 3)
  collapsed.n_obj == 2 &&
  collapsed.n_state == 2 &&
  collapsed_twice == collapsed &&
  chu_biextensional_collapse(c_vec) == c_vec &&
  verify_sieve64_sip_biheyting_and_mac_equivalence() &&
  rp2_f2[0] == 1 &&
  rp2_f2[1] == 1 &&
  rp2_f2[2] == 1 &&
  rp2_f3[0] == 1 &&
  rp2_f3[1] == 0 &&
  rp2_f3[2] == 0
}
